# ----------------------------------------------------------------------
# Resource Booking System — environment variables
# Copy this file to .env (or export these in your shell / deployment
# platform) and adjust the values. Every variable has a sane default
# baked into application.yml, so the app will still boot without any
# of these set — but you should override at least JWT_SECRET and the
# DB credentials before running anywhere near production.
# ----------------------------------------------------------------------

# --- Server ---
SERVER_PORT=8080

# --- Database (defaults target PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# To use MySQL instead, either set these three DB_* vars to MySQL
# equivalents AND set DB_DIALECT=org.hibernate.dialect.MySQLDialect,
# or simply run with SPRING_PROFILES_ACTIVE=mysql (see application-mysql.yml)
# and just set DB_USERNAME / DB_PASSWORD.
# DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

# ddl-auto: validate|update|create|create-drop|none
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Must be a Base64-encoded string decoding to at least 256 bits for HS256.
# Generate one with: openssl rand -base64 32
#JWT_SECRET=VGhpc0lzQVZlcnlMb25nU2VjcmV0S2V5Rm9ySFMyNTZBbGdvcml0aG1BbmRTaG91bGROZXZlckJlQ29tbWl0dGVkITEyMw==
JWT_EXPIRATION_MS=86400000

# --- Seed data (set SEED_ENABLED=false in production) ---
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=User@123
