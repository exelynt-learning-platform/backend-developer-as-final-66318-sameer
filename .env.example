# ----------------------------------------------------------------------
# Resource Booking System — environment variables
# Copy this file to .env (or export these in your shell / deployment
# platform) and adjust the values. Every variable has a sane default
# baked into application.yml, so the app will still boot without any
# of these set — but you should override at least JWT_SECRET and the
# DB credentials before running anywhere near production.
# ----------------------------------------------------------------------

# --- Server ---
SERVER_PORT=8080

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=REPLACE_ME
DB_DRIVER=com.mysql.cj.jdbc.Driver

DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---
# Must decode to at least 32 bytes
# Generate: openssl rand -base64 32
JWT_SECRET=REPLACE_ME_WITH_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# --- Seed ---
SEED_ENABLED=false
SEED_ADMIN_USERNAME=REPLACE_ME
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_USER_USERNAME=REPLACE_ME
SEED_USER_PASSWORD=REPLACE_ME